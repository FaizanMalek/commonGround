# Copy to .env and fill in values
# For Render: set these in Dashboard → Environment (do not commit .env)

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Local MySQL (defaults match README Quick Start)
DB_HOST=localhost
DB_USER=hackathon
DB_PASSWORD=Hackathon123
DB_NAME=CommonGround
DB_PORT=3306
DB_SSL_ENABLED=false

# Production MySQL (Aiven) — for Render; set DB_PASSWORD in Render dashboard only
# DB_HOST=commonground-commonground.h.aivencloud.com
# DB_PORT=16724
# DB_USER=avnadmin
# DB_PASSWORD=your-aiven-password
# DB_NAME=defaultdb
# DB_SSL_ENABLED=true
# DB_CA_CERT_PATH=ca.pem

JWT_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_SECRET=change-me-cookie-secret

CORS_ORIGINS=http://localhost:3000

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

ADMIN_DEFAULT_EMAIL=coordinator@commonground.ca
ADMIN_DEFAULT_PASSWORD=password123

# SMTP (donation confirmation & thank-you emails)
SMTP_USE_ETHEREAL=false
SMTP_ENABLED=false
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CommonGround <noreply@commonground.ca>
