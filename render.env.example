# Paste into Render → Web Service → Environment (secrets only in dashboard, never in git)
# DB_PASSWORD = your Aiven password (from Aiven console, not this file)

NODE_ENV=production
HOST=0.0.0.0

DB_HOST=commonground-commonground.h.aivencloud.com
DB_PORT=16724
DB_USER=avnadmin
DB_PASSWORD=<set-in-render-dashboard>
DB_NAME=defaultdb
DB_SSL_ENABLED=true
DB_CA_CERT_PATH=ca.pem

JWT_SECRET=<generate-random-32+-chars>
COOKIE_SECRET=<generate-random-32+-chars>
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# After first deploy, use your real URL (no trailing slash):
CORS_ORIGINS=https://commonground.onrender.com

ADMIN_DEFAULT_EMAIL=coordinator@commonground.ca
ADMIN_DEFAULT_PASSWORD=<strong-password>
